# ==============================================================================
# SGTCC - Variáveis de Ambiente do Firebase
# ==============================================================================

# Firebase Client SDK (Públicas - utilizadas pelo Frontend / Browser)
NEXT_PUBLIC_FIREBASE_API_KEY=sua-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sgtcc-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sgtcc-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sgtcc-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF0123

# SSO institucional (preencher somente quando o provedor estiver configurado
# no Firebase Authentication; exemplos de IDs: google.com, microsoft.com,
# oidc.<id> ou saml.<id>)
NEXT_PUBLIC_FIREBASE_AUTH_PROVIDER_ID=
NEXT_PUBLIC_FIREBASE_INSTITUTIONAL_EMAIL_DOMAIN=

# Firebase Admin SDK (Privadas - utilizadas apenas no Servidor / API Routes)
FIREBASE_PROJECT_ID=sgtcc-projeto
# Pode repetir o provider público no servidor ou definir um valor equivalente.
FIREBASE_AUTH_PROVIDER_ID=
FIREBASE_INSTITUTIONAL_EMAIL_DOMAIN=
# Credenciais do Admin SDK (usadas pelo app e pelo seed; alternativa à chave JSON abaixo)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sgtcc-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
# Opcional: JSON da chave da conta de serviço (Service Account) em formato string minificada
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Senha das personas de teste criadas por `npm run seed`.
SEED_PASSWORD=defina-uma-senha-de-teste-aqui

# Token da store Vercel Blob conectada a ESTE projeto (nunca usar NEXT_PUBLIC_ no token)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXX
# Deixe PUBLIC enquanto sua store atual for pública. Para documentos privados,
# crie/conecte uma store PRIVADA na Vercel, e troque AS DUAS opções para private.
# Mudanças não tornam arquivos antigos automaticamente privados.
BLOB_ACCESS=public
NEXT_PUBLIC_BLOB_ACCESS=public
